    43	function buildSalesConditions({
    44	  search,
    45	  startDate,
    46	  endDate,
    47	  status,
    48	}: {
    49	  search: string;
    50	  startDate: string;
    51	  endDate: string;
    52	  status: SalesStatusFilter;
    53	}) {
    54	  const conditions: string[] = [];
    55	
    56	  if (search) {
    57	    conditions.push(
    58	      `(m.NumberPrintSalePost LIKE @search OR m.NameCustomer LIKE @search)`,
    59	    );
    60	  }
    61	
    62	  if (startDate) {
    63	    conditions.push("CONVERT(date, m.DateSalePost) >= @startDate");
    64	  }
    65	
    66	  if (endDate) {
    67	    conditions.push("CONVERT(date, m.DateSalePost) <= @endDate");
    68	  }
    69	
    70	  if (status === "cash") {
    71	    conditions.push("ISNULL(m.Cash, 0) > 0");
    72	  } else if (status === "transfer") {
    73	    conditions.push(`(
    74	      ISNULL(m.Transfer, 0) > 0
    75	      OR EXISTS (
    76	        SELECT 1
    77	        FROM dbo.DetailSalePost transferDeposit
    78	        WHERE transferDeposit.NumberPrintSalePost = m.NumberPrintSalePost
    79	          AND transferDeposit.NameProduct LIKE N'%มัดจำ%'
    80	          AND transferDeposit.NameProduct LIKE N'%เงินโอน%'
    81	          AND ISNULL(transferDeposit.SumPrice, 0) < 0
    82	      )
    83	      OR EXISTS (
    84	        SELECT 1
    85	        FROM dbo.WebBillDepositPayments savedDeposit
    86	        WHERE savedDeposit.BillNo = m.NumberPrintSalePost
    87	          AND savedDeposit.PaymentMethod = N'transfer'
    88	          AND savedDeposit.Amount > 0
    89	      )
    90	    )`);
    91	  } else if (status === "unpaid") {
    92	    conditions.push("LTRIM(RTRIM(ISNULL(m.Status, ''))) = N'ค้างชำระ'");
    93	  }
    94	
    95	  return conditions;
    96	}
