    11	interface SaleItem {
    12	  id: string;
    13	  date: string;
    14	  customerName: string;
    15	  customerPhone: string;
    16	  totalPrice: number;
    17	  totalProfit: number;
    18	  cash: number;
    19	  transfer: number;
    20	  deposits: number;
    21	  receivableAmount: number;
