    34	
    35	type SalesStatusFilter = "all" | "cash" | "transfer" | "unpaid";
    36	
    37	function getSafeMoneyExpression(valueExpression: string) {
    38	  const textExpression = `CONVERT(nvarchar(100), ${valueExpression})`;
    39	
    40	  return `ISNULL(CONVERT(money, CASE WHEN ${valueExpression} IS NULL THEN '0' WHEN ISNUMERIC(${textExpression}) = 1 THEN ${textExpression} ELSE '0' END), 0)`;
    41	}
